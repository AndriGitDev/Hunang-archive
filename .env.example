# ── Hunang configuration ────────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env.
#
# The three tiers hold different subsets of these. In production:
#   sensor host  → INGEST_URL, INGEST_TOKEN, SENSOR_NAME  (nothing else)
#   ingest       → everything under "ingest service"
#   web archive  → no environment variables required
# This file supports reproduction of the former live pipeline. The current
# public archive reads a checked-in snapshot and does not need these values.

# Shared secret the shipper presents to the ingest API (Bearer token).
# Generate with: openssl rand -hex 32
INGEST_TOKEN=change-me-openssl-rand-hex-32

# Secret used to HMAC source IPs before storage. Rotating it breaks
# cross-rotation correlation of sources — that is intentional and fine.
# MUST be a different value from INGEST_TOKEN (ingest refuses to start
# otherwise): the sensor holds the token, and if that leaked secret also
# keyed the IP pseudonyms, the pseudonyms would be reversible.
# Generate with: openssl rand -hex 32
IP_HASH_SECRET=change-me-different-from-ingest-token

# ── ingest service ──────────────────────────────────────────────────────
# Postgres connection string. Neon (via the Vercel Marketplace) provisions
# POSTGRES_URL automatically; DATABASE_URL takes precedence if both are set.
DATABASE_URL=postgres://hunang:local-demo-not-a-secret@localhost:5432/hunang

INGEST_PORT=8400
# Public read-only rollups API port. Served on a SEPARATE port so it can be
# firewalled independently of the sensor-only ingest port: :8400 is
# reachable only from the sensor, :8402 is safe to expose publicly (it
# serves the same anonymous aggregates the site already shows). Set
# ROLLUPS_PORT=0 to disable it entirely.
# Both are for the self-hosted/demo server only — on Vercel the two paths
# are separate functions and these are unused.
ROLLUPS_PORT=8402
# Optional: if the public site is on a different origin and you want browsers
# to fetch the rollups API directly, set the allowed origin (CORS). Leave
# empty when the site fetches server-side (the default), which needs no CORS.
ROLLUPS_ALLOW_ORIGIN=
# Read-only cost-control token. It does not protect confidential data; it
# prevents arbitrary callers from waking Postgres. Use the same random value
# as HUNANG_ROLLUPS_TOKEN on the web tier.
ROLLUPS_TOKEN=change-me-openssl-rand-hex-32
# Delete raw events older than this many days. Rollups (anonymous
# aggregates) are kept forever. See docs/DATA-HANDLING.md.
RETENTION_DAYS=30
# How often the self-hosted service recomputes rollups, in seconds. The hourly
# default clusters work so a scale-to-zero datastore can sleep between runs.
# On Vercel this is the cron schedule in ingest/vercel.json instead.
AGGREGATE_INTERVAL_SECONDS=3600

# Shared secret protecting the scheduled aggregation endpoint. Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`; the endpoint refuses to
# run without one. Vercel-only. Generate with: openssl rand -hex 32
CRON_SECRET=

# Country/ASN enrichment needs NO configuration: the ingest build downloads
# the DB-IP Lite databases (free, CC BY 4.0, no account) and bundles them, so
# lookups happen offline and an attacker's IP is never sent to a third party.
# Attribution to DB-IP is published on the site and is a licence condition.
#
# Optional upgrade: set a MaxMind licence key to use GeoLite2 instead —
# also free, but needs an account, and refreshes twice weekly rather than
# monthly. https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Optional explicit paths, if you manage the .mmdb files yourself instead.
GEOIP_COUNTRY_DB=
GEOIP_ASN_DB=

# ── shipper (runs next to Cowrie on the sensor host) ────────────────────
# Where the shipper POSTs events. On the sensor host this is the ONLY
# allowed egress destination — see infra/nftables.conf.
#
# The plaintext http://…:8400 below is for the local Docker network ONLY.
# In production this is HTTPS to the ingest deployment
# (https://your-ingest-host.example/v1/events). Never plaintext over the
# internet: INGEST_TOKEN and all telemetry would travel in cleartext and the
# token — the sensor's one secret — would be sniffable on-path.
INGEST_URL=http://ingest:8400/v1/events
COWRIE_LOG=/cowrie/var/log/cowrie/cowrie.json
SENSOR_NAME=hp-1
# Disk-backed retry/checkpoint state. Production Compose mounts a dedicated
# named volume here; do not point this at the read-only Cowrie log mount.
SHIPPER_STATE_DIR=/state
# Flush on aligned UTC boundaries. One hour matches the aggregation/CDN
# cadence and leaves Neon enough idle time to scale to zero.
SHIPPER_FLUSH_INTERVAL_SECONDS=3600
# Stop advancing the Cowrie checkpoint if the durable spool reaches 256 MiB.
# The source log remains the recovery path rather than silently dropping data.
SHIPPER_MAX_SPOOL_BYTES=268435456
# One-time recovery lever. With no existing checkpoint, scan the active Cowrie
# log from byte zero but enqueue only events at/after this ISO timestamp. Leave
# empty during normal operation; duplicate replay IDs are deterministic.
SHIPPER_REPLAY_SINCE=

# ── web ─────────────────────────────────────────────────────────────────
# The public site fetches ONLY the pre-aggregated, anonymous rollups from
# the ingest deployment's read-only API. It has no database driver and never
# talks to the sensor. Leave empty to render an empty dashboard.
HUNANG_ROLLUPS_URL=http://localhost:8402/v1/rollups
HUNANG_ROLLUPS_TOKEN=change-me-openssl-rand-hex-32
